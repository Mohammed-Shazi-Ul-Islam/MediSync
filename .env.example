# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=MediSync
APP_VERSION=0.1.0
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=medisync
POSTGRES_PASSWORD=medisync_secret
POSTGRES_DB=medisync_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medisync:medisync_secret@db:5432/medisync_db

# For local development (outside Docker), change @db to @localhost:
# DATABASE_URL=postgresql://medisync:medisync_secret@localhost:5432/medisync_db

# ─── Redis + Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# For local development (outside Docker):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Gemini AI (Free via Google AI Studio) ────────────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── ChromaDB (Module 02 — RAG Vector Store) ───────────────────────────────
# Local persistence directory (relative to project root, or absolute path)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=medical_kb

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
# Sign up free: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── SMTP Email (Module 04 — Notification Pipeline) ───────────────────────────
# Gmail example: enable "App Passwords" in your Google account and use that here.
# For other providers (Outlook, SendGrid SMTP) adjust HOST/PORT accordingly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@medisync.io

# ─── Escalation Config (Module 04) ────────────────────────────────────────────
# How many minutes before an unaccepted case escalates to the next doctor
NOTIFICATION_ESCALATION_MINUTES=5
# How many escalation hops before an admin alert fires
NOTIFICATION_MAX_ESCALATIONS=3

# ─── Specialist Router (Module 03) ────────────────────────────────────────────
CHROMA_SPECIALIST_COLLECTION_NAME=specialist_profiles
ROUTER_RULE_CONFIDENCE_THRESHOLD=0.80
ROUTER_TOP_K_SPECIALIST_DOCS=3
