# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=MediSync
APP_VERSION=0.1.0
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=medisync
POSTGRES_PASSWORD=medisync_secret
POSTGRES_DB=medisync_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medisync:medisync_secret@db:5432/medisync_db

# For local development (outside Docker), change @db to @localhost:
# DATABASE_URL=postgresql://medisync:medisync_secret@localhost:5432/medisync_db

# ─── Redis + Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# For local development (outside Docker):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Gemini AI (Free via Google AI Studio) ────────────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
# Sign up free: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
